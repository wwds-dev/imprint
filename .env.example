# Imprint — API keys
# Settings → API keys edits this file for you (paste, Test, Save All) and the
# running app uses the keys at once. Editing by hand works too: paste a key
# after the '=' (no quotes). Leave blank to disable that provider.
# This file lives in ~/Library/Application Support/Imprint/.env for the packaged app.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Higgsfield Cloud uses a key ID + secret pair, not a bearer token.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional endpoint overrides for the default model. Leave blank to use
# Seedance 2.5 (/bytedance/seedance-2.5/text-to-video and image-to-video).
HIGGSFIELD_TEXT_VIDEO_ENDPOINT=
HIGGSFIELD_IMAGE_VIDEO_ENDPOINT=

# Alibaba Qwen (Model Studio / DashScope). Key from bailian.console.alibabacloud.com
DASHSCOPE_API_KEY=
# Optional — your Model Studio workspace ID (Singapore; letters, digits and
# hyphens only, not a web address). Alibaba recommends the workspace host
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com; the standard
# international host still works, so this is optional. Applies to Qwen chat
# only (not Wan video or Qwen Image). DASHSCOPE_BASE_URL below overrides it.
DASHSCOPE_WORKSPACE_ID=
# Optional — defaults to the standard international endpoint. Set this to a full
# URL to override the workspace ID, e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
# for a mainland China account. The API-keys tile and scripts/check_keys.py
# say when the standard host is in use.
DASHSCOPE_BASE_URL=
# Wan video uses DashScope's asynchronous /api/v1 endpoint rather than its
# OpenAI-compatible chat endpoint. The standard international host works by
# default; the workspace ID above does not change it. Qwen Image uses this too.
# Example (not yet confirmed to serve Wan video):
# https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_BASE_URL=

# ElevenLabs — optional. Used in two places: as one of Booth's three narration
# routes (the others are OpenAI TTS via OPENAI_API_KEY and Gemini TTS via
# GOOGLE_API_KEY — pick the route in Booth's Narrator menu), and as the paid
# voice in Press's Shorts tab. Without it, Booth offers the other two routes
# and Shorts keeps its free on-device voice; the voice list reads
# "(ElevenLabs key not set)".
ELEVENLABS_API_KEY=

# ── Press publishing data (optional) ─────────────────────────────────────────
# PublishDrive sales and catalogue data for Press's Overview and the sales
# Q&A. Everything else in Press — exports, approved versions, KDP CSV import,
# the Submission Ledger — works without it. Source: agents/manuscript/
# publishdrive_client.py. The endpoint has not yet been exercised against a
# live account (readiness audit 2026-10-09); the first "Refresh Data" is the
# test, and it is a metadata read that bills nothing.
PUBLISHDRIVE_API_KEY=

# ── Herald publishing (optional) ─────────────────────────────────────────────
# Only needed to post from the Social workspace. Drafting and scheduling work
# without any of these; the Accounts tab states what each connection grants
# before you set it up, and names whatever is still missing.
# Source of truth: agents/social/publishing.py.

# Reddit — script-app OAuth (a personal app on your own account, no review).
# Requests exactly the `submit` scope. Note the honest warning the in-app guide
# also gives: this flow keeps your Reddit password in this file, so anyone who
# can read it can act as your account.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Pinterest — a business account's access token with pins:write and boards:read.
PINTEREST_ACCESS_TOKEN=

# YouTube uses no key here. It needs a Google Cloud OAuth client of type
# Desktop, with the client_secret*.json dropped into vidforge's secrets folder;
# the first upload opens a browser consent screen and vidforge caches the token.
