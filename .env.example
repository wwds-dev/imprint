# Imprint — API keys
# Paste your keys after the '=' (no quotes). Leave blank to disable that provider.
# This file lives in ~/Library/Application Support/Imprint/.env for the packaged app.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Higgsfield Cloud uses a key ID + secret pair, not a bearer token.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional model-specific overrides. Defaults use Seedance 1.0 Lite.
HIGGSFIELD_TEXT_VIDEO_ENDPOINT=/bytedance/seedance/v1/lite/text-to-video
HIGGSFIELD_IMAGE_VIDEO_ENDPOINT=/bytedance/seedance/v1/lite/image-to-video

# Alibaba Qwen (Model Studio / DashScope). Key from bailian.console.alibabacloud.com
DASHSCOPE_API_KEY=
# Optional — defaults to the international endpoint. Set this for a mainland
# China account (https://dashscope.aliyuncs.com/compatible-mode/v1) or a
# workspace-scoped regional host.
DASHSCOPE_BASE_URL=
# Wan video uses DashScope's asynchronous /api/v1 endpoint rather than its
# OpenAI-compatible chat endpoint. The legacy international host works by
# default; set the workspace-scoped regional base for better reliability.
# Example: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_BASE_URL=
